Subject: [PATCH] audio: guard HAL callback against released stream

---
 media/libaudiohal/impl/StreamHalAidl.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/media/libaudiohal/impl/StreamHalAidl.cpp b/media/libaudiohal/impl/StreamHalAidl.cpp
index 3d4e5f6..4e5f6a7 100644
--- a/media/libaudiohal/impl/StreamHalAidl.cpp
+++ b/media/libaudiohal/impl/StreamHalAidl.cpp
@@ -410,5 +410,7 @@ void StreamHalAidl::onWriteReady() {
     auto callback = mCallback.promote();
+    if (callback == nullptr) return;
+
     callback->onWriteReady();
 }
 
 void StreamHalAidl::onDrainReady() {
